FiniteCopy.ConvexRoof.exists_uniform_support (d : ℕ) (hd : 0 < d) (g : (Fin d → ℝ) → ℝ)
  (hg : ContinuousOn g (stdSimplex ℝ (Fin d))) :
  ∃ p q lam,
    (∀ (a : Fin d), p a ∈ stdSimplex ℝ (Fin d)) ∧
      (∀ (a : Fin d), 0 ≤ q a) ∧
        ∑ a, q a = 1 ∧
          (∀ (i : Fin d), ∑ a, q a * p a i = 1 / ↑d) ∧
            (∀ p ∈ stdSimplex ℝ (Fin d), g p ≤ ∑ i, lam i * p i) ∧ ∑ a, q a * g (p a) = (∑ i, lam i) / ↑d
