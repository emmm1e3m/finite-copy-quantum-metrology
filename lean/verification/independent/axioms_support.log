FiniteCopy.ConvexRoof.primal_attained (d : ℕ) (hd : 0 < d) (g : (Fin d → ℝ) → ℝ)
  (hg : ContinuousOn g (FiniteCopy.ConvexRoof.Simplex d)) :
  ∃ P,
    FiniteCopy.ConvexRoof.mixMean P = FiniteCopy.ConvexRoof.uniform d ∧
      ∀ (s : Finset (Fin d → ℝ)) (w : (Fin d → ℝ) → ℝ),
        ↑s ⊆ FiniteCopy.ConvexRoof.Simplex d →
          (∀ p ∈ s, 0 ≤ w p) →
            ∑ p ∈ s, w p = 1 →
              ∑ p ∈ s, w p • p = FiniteCopy.ConvexRoof.uniform d →
                ∑ p ∈ s, w p * g p ≤ FiniteCopy.ConvexRoof.mixValue g P
