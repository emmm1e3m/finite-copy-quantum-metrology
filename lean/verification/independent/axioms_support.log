FiniteCopy.ConvexRoof.finite_mixture_reduce (d : ℕ) (hd : 0 < d) (g : (Fin d → ℝ) → ℝ) (x : Fin d → ℝ)
  (s : Finset (Fin d → ℝ)) (w : (Fin d → ℝ) → ℝ) (hS : ↑s ⊆ FiniteCopy.ConvexRoof.Simplex d) (hw : ∀ p ∈ s, 0 ≤ w p)
  (h1 : ∑ p ∈ s, w p = 1) (hx : ∑ p ∈ s, w p • p = x) :
  ∃ p q,
