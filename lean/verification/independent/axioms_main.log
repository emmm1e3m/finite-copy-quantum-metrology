FiniteCopy.MainTheorem.finite_N_gaussian_locally_unbiased (N : ℕ) (hN : 0 < N) (a b : Fin 2) :
  ∫ (z : FiniteCopy.MainTheorem.Outcome N),
        CopyQuantumMetrology.born (CopyQuantumMetrology.TensorModel.rhoTensor N 0 0)
            ((FiniteCopy.MainTheorem.gaussianMeasurement N).effect z) *
          FiniteCopy.MainTheorem.gaussianEstimator N z a ∂FiniteCopy.MainTheorem.outcomeMeasure N =
      0 ∧
    HasDerivAt
      (fun θ =>
        ∫ (z : FiniteCopy.MainTheorem.Outcome N),
          FiniteCopy.MainTheorem.gaussianEstimator N z a *
            CopyQuantumMetrology.born (FiniteCopy.MainTheorem.rhoAxis N b θ)
              ((FiniteCopy.MainTheorem.gaussianMeasurement N).effect z) ∂FiniteCopy.MainTheorem.outcomeMeasure N)
      (if a = b then 1 else 0) 0
