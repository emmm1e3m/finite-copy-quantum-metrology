theorem CopyQuantumMetrology.GaussianLimit.actual_U_limit : Filter.Tendsto
  (fun n =>
    CopyQuantumMetrology.ContinuousEnergy.U n (CopyQuantumMetrology.epsilon (CopyQuantumMetrology.spinJ n)) /
      CopyQuantumMetrology.spinJ n)
  Filter.atTop (nhds (1 / 2)) :=
have hb :=
  Filter.mp_mem CopyQuantumMetrology.GaussianLimit.eventually_spin_admissible
    (Filter.univ_mem'
      (id fun n ha =>
        And.casesOn ha fun hn right =>
          And.casesOn right fun heps right =>
            And.casesOn right fun heps1 right =>
              And.casesOn right fun hd right =>
                And.casesOn right fun hdhalf right =>
                  And.casesOn right fun hlargeD htail =>
                    have hd1 :=
                      le_of_not_gt fun a =>
                        Mathlib.Tactic.Linarith.lt_irrefl
                          (Eq.mp
                            (congrArg (fun _a => _a < 0)
                              (Mathlib.Tactic.Ring.of_eq
                                (Mathlib.Tactic.Ring.Common.add_congr
                                  (Mathlib.Tactic.Ring.Common.add_congr
                                    (Mathlib.Tactic.Ring.Common.sub_congr
                                      (Mathlib.Tactic.Ring.cast_zero (Mathlib.Meta.NormNum.isNat_ofNat ℝ Nat.cast_zero))
                                      (Mathlib.Tactic.Ring.Common.atom_pf
                                        (CopyQuantumMetrology.delta (CopyQuantumMetrology.spinJ n)) rfl
                                        (Eq.mpr
                                          (id
                                            (congrArg
                                              (fun _a =>
                                                CopyQuantumMetrology.delta (CopyQuantumMetrology.spinJ n) ^
                                                      Nat.rawCast 1 *
                                                    Nat.rawCast 1 =
                                                  CopyQuantumMetrology.delta (CopyQuantumMetrology.spinJ n) ^
                                                      Nat.rawCast 1 *
                                                    _a)
                                              (Eq.symm rfl)))
                                          (Eq.refl
                                            (CopyQuantumMetrology.delta (CopyQuantumMetrology.spinJ n) ^ Nat.rawCast 1 *
                                              Nat.rawCast 1))))
                                      (Mathlib.Tactic.Ring.Common.sub_pf
                                        (Mathlib.Tactic.Ring.Common.neg_add
                                          (Mathlib.Tactic.Ring.Common.neg_mul
                                            (CopyQuantumMetrology.delta (CopyQuantumMetrology.spinJ n)) (Nat.rawCast 1)
                                            (Mathlib.Meta.NormNum.IsInt.to_raw_eq
                                              (Mathlib.Meta.NormNum.isInt_neg (Eq.refl Neg.neg)
                                                (Mathlib.Meta.NormNum.IsNat.to_isInt
                                                  (Mathlib.Meta.NormNum.IsNat.of_raw ℝ 1))
                                                (Eq.refl (Int.negOfNat 1)))))
                                          Mathlib.Tactic.Ring.Common.neg_zero)
                                        (Mathlib.Tactic.Ring.Common.add_pf_zero_add
                                          (CopyQuantumMetrology.delta (CopyQuantumMetrology.spinJ n) ^ Nat.rawCast 1 *
                                              (Int.negOfNat 1).rawCast +
                                            0))))
                                    (Mathlib.Tactic.Ring.Common.sub_congr
                                      (Mathlib.Tactic.Ring.Common.mul_congr
                                        (Mathlib.Tactic.Ring.cast_pos (Mathlib.Meta.NormNum.isNat_ofNat ℝ (Eq.refl 2)))
                                        (Mathlib.Tactic.Ring.Common.atom_pf
                                          (CopyQuantumMetrology.delta (CopyQuantumMetrology.spinJ n)) rfl
                                          (Eq.mpr
                                            (id
                                              (congrArg
                                                (fun _a =>
                                                  CopyQuantumMetrology.delta (CopyQuantumMetrology.spinJ n) ^
                                                        Nat.rawCast 1 *
                                                      Nat.rawCast 1 =
                                                    CopyQuantumMetrology.delta (CopyQuantumMetrology.spinJ n) ^
                                                        Nat.rawCast 1 *
                                                      _a)
                                                (Eq.symm rfl)))
                                            (Eq.refl
                                              (CopyQuantumMetrology.delta (CopyQuantumMetrology.spinJ n) ^
                                                  Nat.rawCast 1 *
                                                Nat.rawCast 1))))
                                        (Mathlib.Tactic.Ring.Common.add_mul
                                          (Mathlib.Tactic.Ring.Common.mul_add
                                            (Mathlib.Tactic.Ring.Common.mul_pf_right
                                              (CopyQuantumMetrology.delta (CopyQuantumMetrology.spinJ n))
                                              (Nat.rawCast 1)
                                              (Mathlib.Meta.NormNum.IsNat.to_raw_eq
                                                (Mathlib.Meta.NormNum.isNat_mul (Eq.refl HMul.hMul)
                                                  (Mathlib.Meta.NormNum.IsNat.of_raw ℝ 2)
                                                  (Mathlib.Meta.NormNum.IsNat.of_raw ℝ 1) (Eq.refl 2))))
                                            (Mathlib.Tactic.Ring.Common.mul_zero (Nat.rawCast 2))
                                            (Mathlib.Tactic.Ring.Common.add_pf_add_zero
                                              (CopyQuantumMetrology.delta (CopyQuantumMetrology.spinJ n) ^
                                                    Nat.rawCast 1 *
                                                  Nat.rawCast 2 +
                                                0)))
                                          (Mathlib.Tactic.Ring.Common.zero_mul
                                            (CopyQuantumMetrology.delta (CopyQuantumMetrology.spinJ n) ^ Nat.rawCast 1 *
                                                Nat.rawCast 1 +
                                              0))
                                          (Mathlib.Tactic.Ring.Common.add_pf_add_zero
                                            (CopyQuantumMetrology.delta (CopyQuantumMetrology.spinJ n) ^ Nat.rawCast 1 *
                                                Nat.rawCast 2 +
                                              0))))
