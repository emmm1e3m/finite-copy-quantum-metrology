                                          (Mathlib.Meta.NormNum.isNat_eq_true
                                            (Mathlib.Meta.NormNum.isNat_mul (Eq.refl HMul.hMul)
                                              (Mathlib.Meta.NormNum.isNat_ofNat ℝ Nat.cast_one)
                                              (Mathlib.Meta.NormNum.isNat_ofNat ℝ (Eq.refl 2)) (Eq.refl 2))
                                            (Mathlib.Meta.NormNum.isNat_ofNat ℝ (Eq.refl 2)))))))
                                  (Mathlib.Tactic.Linarith.mul_neg (Mathlib.Tactic.Linarith.sub_neg_of_lt hdhalf)
                                    (Mathlib.Meta.NormNum.isNat_lt_true
                                      (Mathlib.Meta.NormNum.isNat_ofNat ℝ Nat.cast_zero)
                                      (Mathlib.Meta.NormNum.isNat_ofNat ℝ (Eq.refl 2)) (Eq.refl false)))))
                              (Mathlib.Tactic.Linarith.sub_neg_of_lt a)));
                    have hd2 := pow_le_one₀ (LT.lt.le hd) hd1;
                    have hJe :=
                      have hh :=
                        mul_le_mul_of_nonneg_left hd2
                          (mul_nonneg (LT.lt.le (CopyQuantumMetrology.spinJ_pos n)) (LT.lt.le heps));
                      LE.le.trans htail
                        (Eq.mp
                          (congrArg
                            (LE.le
                              (CopyQuantumMetrology.spinJ n *
                                  CopyQuantumMetrology.epsilon (CopyQuantumMetrology.spinJ n) *
                                CopyQuantumMetrology.delta (CopyQuantumMetrology.spinJ n) ^ 2))
                            (mul_one
                              (CopyQuantumMetrology.spinJ n *
                                CopyQuantumMetrology.epsilon (CopyQuantumMetrology.spinJ n))))
                          hh);
                    have hlargeE := (div_le_iff₀ heps).mpr hJe;
                    CopyQuantumMetrology.GaussianLimit.actual_total_error hn heps heps1 hd hd1 hlargeE
                      (le_of_not_gt fun a =>
