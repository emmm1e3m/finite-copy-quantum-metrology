theorem FiniteCopy.Risk.exists_density_of_operator_povm.{u_1, u_2} : ∀ {ι : Type u_1} {Ω : Type u_2} [inst : Fintype ι]
  [inst_1 : DecidableEq ι] [inst_2 : MeasurableSpace Ω] (F : Set Ω → Matrix ι ι ℂ),
  F ∅ = 0 →
    (∀ (s : Set Ω), MeasurableSet s → (F s).PosSemidef) →
      F Set.univ = 1 →
        (∀ (s : ℕ → Set Ω),
            (∀ (k : ℕ), MeasurableSet (s k)) →
              (Pairwise fun i j => Disjoint (s i) (s j)) → HasSum (fun k => F (s k)) (F (⋃ k, s k))) →
          ∃ μ,
            MeasureTheory.IsFiniteMeasure μ ∧
              ∃ P, ∀ (A : Set Ω), MeasurableSet A → FiniteCopy.Risk.DensityPOVM.operatorMeasure μ P A = F A :=
fun {ι} {Ω} [Fintype ι] [DecidableEq ι] [MeasurableSpace Ω] F h0 hp h1 hadd =>
  let M := FiniteCopy.Risk.OperatorPOVM.ofSetFunction F h0 hp h1 hadd;
  Exists.intro M.dominatingMeasure
    ⟨inferInstance,
      Exists.intro M.toDensityPOVM fun A hA =>
        Eq.trans (FiniteCopy.Risk.OperatorPOVM.toDensityPOVM_operatorMeasure M A hA)
          (FiniteCopy.Risk.OperatorPOVM.ofSetFunction_apply F h0 hp h1 hadd A hA)⟩
